{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickFlash",
  "version": "1.1.0",
  "identifier": "com.fugamaru.quickflash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickFlash",
        "width": 1280,
        "height": 810
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FUGAMARU",
    "shortDescription": "Easily import metadata from Spotify into MP3 files.",
    "longDescription": "Easily import metadata from Spotify into MP3 files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
